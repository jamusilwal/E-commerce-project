# ============================================
# HAMROLOK BAZAR — Server Environment Variables
# ============================================

# Server
NODE_ENV=development
PORT=5001

# Database (PostgreSQL — local or Neon for production)
DATABASE_URL="postgresql://user:password@localhost:5432/hamrolok_bazar?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET=your_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary (Media Assets)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS and payment redirects). Use https:// in production.
# Several origins can be listed comma-separated in CLIENT_URLS (e.g. with and without www).
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=https://hamrolokbazar.com,https://www.hamrolokbazar.com

# ============================================
# HTTPS / TLS
# ============================================
# Built-in HTTPS (local dev or a server without a reverse proxy).
# Run `npm run cert:dev` to create a local certificate, then uncomment:
# SSL_KEY_PATH=../certs/localhost-key.pem
# SSL_CERT_PATH=../certs/localhost.pem
# HTTP_REDIRECT_PORT=5080        # optional: plain-HTTP port that redirects to HTTPS

# Behind Nginx / Caddy / Render / Railway that terminate TLS (defaults to 1 in production)
# TRUST_PROXY=1
# FORCE_HTTPS=true               # redirect http -> https (default: true in production)
# HSTS_ENABLED=true              # Strict-Transport-Security (default: true in production)
# HSTS_MAX_AGE=31536000
# HSTS_PRELOAD=false

# Refresh-token cookie. Use "none" when the frontend and API are on different sites
# (e.g. *.vercel.app + *.onrender.com); "strict" or "lax" when they share a domain.
# COOKIE_SAME_SITE=strict
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# eSewa Payment Gateway (Sandbox: EPAYTEST)
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np

# Khalti Payment Gateway
KHALTI_SECRET_KEY=your_khalti_secret_key
KHALTI_GATEWAY_URL=https://a.khalti.com

# Transaction Cryptographic Signing (RSA-2048)
TRANSACTION_SIGNING_KEY_ID=hlb-rsa-2026-v1
TRANSACTION_SIGNING_PRIVATE_KEY_PATH=keys/transaction_private.pem
TRANSACTION_SIGNING_PUBLIC_KEY_PATH=keys/transaction_public.pem
# Alternatively provide base64/PEM strings directly:
# TRANSACTION_SIGNING_PRIVATE_KEY=
# TRANSACTION_SIGNING_PUBLIC_KEY=

# Email Notifications (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME="HAMROLOK BAZAR"
ADMIN_NOTIFICATION_EMAIL=admin@hamrolokbazar.com

# WhatsApp Cloud API Notifications (Meta)
WHATSAPP_CLOUD_API_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
ADMIN_WHATSAPP_NUMBER=9779827815000
WHATSAPP_API_VERSION=v20.0
