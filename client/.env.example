# Copy to client/.env.local for local overrides (ignored by git).

# API base URL. Leave unset to use "/api" on the same origin (proxied by Vite in development).
# In production, point it at your HTTPS API if it's on another domain:
# VITE_API_URL=https://api.hamrolokbazar.com/api

# Serve the Vite dev server over HTTPS (run `npm run cert:dev` in /server first)
# VITE_HTTPS=true

# Where the dev server forwards /api. Use https:// when the API runs with SSL_KEY_PATH/SSL_CERT_PATH.
# VITE_PROXY_TARGET=https://localhost:5001
